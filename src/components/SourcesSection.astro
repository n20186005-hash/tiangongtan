---
import SectionHeading from '@/components/SectionHeading.astro';
import { siteInfo } from '@/data/site';
---
<section class="section" id="sources">
  <div class="container">
    <SectionHeading
      eyebrow="資料來源"
      title="資料來源與引用說明"
      text="本頁評分、評價與地圖資訊的來源與同步時間如下，便於查核與進一步延伸閱讀。"
    />
    <div class="sources-card">
      <div class="source-row">
        <span class="source-tag">評價</span>
        <span class="source-meta">同步時間 {siteInfo.syncDate}</span>
        <p class="source-note">
          同步自 Google 地圖用戶評價，同步時間 {siteInfo.syncDate}；版權歸原作者與 Google 地圖所有
        </p>
      </div>
      <ul class="source-links">
        <li>
          <a href={siteInfo.mapsShareUrl} target="_blank" rel="noopener noreferrer"
            >在谷歌地圖查看全部評價 ↗</a
          >
        </li>
        <li>
          <a href={siteInfo.govTourismUrl} target="_blank" rel="noopener noreferrer"
            >新竹市觀光旅遊網（政府官方旅遊資訊）↗</a
          >
        </li>
      </ul>
    </div>
  </div>
</section>
