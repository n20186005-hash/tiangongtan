---
import { navItems, siteInfo, siteNotice } from '@/data/site';
import { absoluteAsset, absoluteUrl, withTrailingSlash } from '@/lib/urls';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${siteInfo.fullName}｜${siteInfo.tagline}`,
  description = siteInfo.description,
  image = siteInfo.ogImage
} = Astro.props;
const pageTitle = title.includes(siteInfo.name) ? title : `${title}｜${siteInfo.name}`;
const currentPath = withTrailingSlash(Astro.url.pathname);
const canonical = absoluteUrl(currentPath, Astro.site);
const ogImage = absoluteAsset(image, Astro.site);
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#182c25" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={`${siteInfo.name}（${siteInfo.city}）`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <slot name="jsonld" />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteInfo.ga4}`}></script>
    <script is:inline set:html={`
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '${siteInfo.ga4}');
    `} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <div class="site-shell">
      <header class="header">
        <div class="container nav-wrap">
          <a class="brand" href="/" aria-label="回到首頁">
            <img class="brand-mark" src="/favicon.svg" alt="" width="41" height="41" aria-hidden="true" />
            <span>{siteInfo.name}</span>
          </a>
          <nav class="nav-links" aria-label="主要導覽">
            {navItems.map((item) => (
              <a href={item.href} aria-current={withTrailingSlash(item.href) === currentPath ? 'page' : undefined}>{item.label}</a>
            ))}
          </nav>
        </div>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="footer">
        <div class="container footer-grid">
          <div>
            <strong>{siteInfo.fullName}</strong>
            <p>{siteNotice.about}</p>
          </div>
          <div>
            <small>地址：{siteInfo.address}</small>
            <small>電話：{siteInfo.phone}（景點場所聯繫電話，非本站客服）</small>
          </div>
          <div>
            <small>資料來源：Google 地圖、新竹市觀光旅遊網</small>
            <small>
              官方廟方資訊：
              <a href={siteInfo.officialTempleUrl} target="_blank" rel="noopener noreferrer"
                >新竹天公壇官方網站 ↗</a
              >
            </small>
            <small>聯絡方式：{siteInfo.contactEmail}</small>
          </div>
        </div>
        <div class="container footer-note">
          <p>{siteNotice.text}</p>
          <p>
            本站所載開放時間、收費與活動資訊為編輯整理內容（核對時間 {siteInfo.syncDate}），實際情形請以現場公告與官方來源為準；
            {siteNotice.reviewNote}
          </p>
        </div>
      </footer>
    </div>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
