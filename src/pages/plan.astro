---
export const prerender = true;

import ItineraryPlanner from '@/components/ItineraryPlanner.astro';
import MemorialCard from '@/components/MemorialCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import { buildBreadcrumbSchema } from '@/lib/schema';
---
<BaseLayout title="天公壇公園行程規劃與紀念卡｜新竹半日遊工具" description="用本地行程清單收藏天公壇公園想去的點，再用 Canvas 合成專屬景點紀念卡；適合規劃新竹市區半日遊。">
  <Fragment slot="jsonld">
    <JsonLd data={buildBreadcrumbSchema([{ name: '天公壇公園', url: '/' }, { name: '行程工具', url: '/plan/' }], Astro.site)} />
  </Fragment>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">我的旅程</span>
      <h1>行程清單與紀念卡</h1>
      <p>這一頁所有互動都在瀏覽器本地完成：行程清單存在 localStorage，照片紀念卡用 Canvas 合成，不需要帳號也不會上傳照片。</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid-2">
      <ItineraryPlanner />
      <div class="round-image"><img src="/images/tiangongtan-keya-creek-green.webp" alt="天公壇公園綠地" loading="lazy" decoding="async" /></div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <MemorialCard />
    </div>
  </section>
</BaseLayout>
