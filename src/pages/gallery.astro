---
export const prerender = true;

import Gallery from '@/components/Gallery.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import { buildBreadcrumbSchema } from '@/lib/schema';
---
<BaseLayout title="天公壇公園照片牆｜九龍柱夜景、吊橋與廟宇影像" description="天公壇公園照片集：九龍柱夜景、吊橋、客雅溪綠地與新竹天公壇廟宇細節，先看氛圍再決定怎麼排行程。">
  <Fragment slot="jsonld">
    <JsonLd data={buildBreadcrumbSchema([{ name: '天公壇公園', url: '/' }, { name: '照片牆', url: '/gallery/' }], Astro.site)} />
  </Fragment>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">影像散步</span>
      <h1>照片牆</h1>
      <p>用大圖網格集中看天公壇公園的視覺氣質：九龍柱、夜景、入口、廟宇屋脊與溪畔綠地。點擊照片可放大檢視。</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="八景選輯" title="九龍柱、廟埕與溪畔綠意" text="從白天石雕的立體細節、夜間點燈，到廟宇朱紅金飾與公園綠意，依現場視角逐張觀看。" />
      <Gallery />
    </div>
  </section>
</BaseLayout>
